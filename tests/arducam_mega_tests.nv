// arducam_mega_tests — the driver over a double of the module: a register
// file and a FIFO behind an SPI slave that follows Arducam's Mega SPI
// Camera Series Application Note (September 2023, §3) and the SDK's
// capture sequence, so the command byte, the dummy byte, the burst reads,
// the waits and the controls are checked on the host, one transaction at a
// time.  The FIFO holds a JPEG made on the host (`tests/data`, 16x16, 304
// bytes) and is not a recording of a camera.
//
// The double's state `st`:
//   0 the byte index inside the SPI window    1 the command's register
//   2 the cycle: 1 read, 2 write, 3 burst     3 1 when a module is there
//   4 reads of STATE that still show busy     5 polls before a started
//     capture is done                         6 1 while a capture runs
//   7 the FIFO read pointer                   8 1 after the first burst
//   9 1 inside an SPI window                  10 the SPI clock, 11 its mode
//   12 the bytes the FIFO holds               13 the length reported
//   14 the milliseconds waited                15 1 if a capture never ends
//   17 1 if the sensor bus is never idle      18 the sensor ID
//   20 reads of STATE that still show bit 3   21 1 when the done flag is set
//   22 the busy reads a reset leaves          40 1 when this burst has a dummy
//   41 the year, 42 the month, 43 the day, 44 the firmware number
//   30 the register whose writes the port refuses, plus one; 34 the value
//   it refuses, plus one, or 0 for any; 31 the register whose reads the
//   port refuses, plus one; 32 1 if bursts are refused; 33 1 if setup is
//   refused; 67 1 to keep no log; 99 the entries in the log.
//
// Log entries: an SPI window is 3, the bytes the controller clocked out,
// -1.

use std.test
use embedded_hal.{ BoardSpi, BoardGpio, BoardTimer, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use arducam_mega
use arducam_mega.{ MegaPort, MegaState, MegaChunk, MegaLink, MegaVersion, Arducam }
use mega_jpeg
use mega_jpeg.{ JpegScan }
use mega_file

// The chip select pin of the board's wiring.
const CS = 7

// ── The double ───────────────────────────────────────────────────────

struct Cam
    regs: HashMap<Int, Int>
    st: HashMap<Int, Int>
    fifo: HashMap<Int, Int>
    log: HashMap<Int, Int>

@tier(app)
fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// A module that is there, an ID of 0x85 and nothing in the FIFO.
@tier(app)
fn cam() -> Cam
    let c = Cam { regs: HashMap.new(), st: HashMap.new(), fifo: HashMap.new(), log: HashMap.new() }
    c.st.insert(3, 1)
    c.st.insert(18, 0x85)
    c.st.insert(41, 25)
    c.st.insert(42, 2)
    c.st.insert(43, 28)
    c.st.insert(44, 3)
    c

@tier(app)
fn log_push(c: Cam, v: Int)
    if at(c.st, 67) == 1
        return
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

@tier(app)
fn log_clear(c: Cam)
    c.st.insert(99, 0)

// Asserts the log holds exactly `want`, then empties it.
@tier(app)
fn log_is(c: Cam, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

// The window of a register read: the command, the dummy byte and the
// filler of the one data byte.
@tier(app)
fn rd_log(reg: Int) -> [Int]
    [3, reg, 0, 0, -1]

// The window of a register write.
@tier(app)
fn wr_log(reg: Int, v: Int) -> [Int]
    [3, reg | 0x80, v, -1]

// The window of a burst of `n` bytes, with the dummy byte if `first`.
@tier(app)
fn burst_log(first: Bool, n: Int) -> [Int]
    var out: [Int] = [3, 0x3C]
    if first
        list.push(out, 0)
    for _i in 0..n
        list.push(out, 0)
    list.push(out, -1)
    out

// STATE (0x44) as the module answers it: bits 1:0 = 0b10 when the sensor
// bus is idle, bit 2 once a capture has finished, bit 3 while busy.
@tier(app)
fn state_read(c: Cam) -> Int
    if at(c.st, 6) == 1
        if at(c.st, 15) == 0
            if at(c.st, 5) > 0
                c.st.insert(5, at(c.st, 5) - 1)
            else
                c.st.insert(6, 0)
                c.st.insert(21, 1)
    var v = 0
    if at(c.st, 17) == 0
        if at(c.st, 4) > 0
            c.st.insert(4, at(c.st, 4) - 1)
        else
            v = 0x02
    if at(c.st, 21) == 1
        v = v | 0x04
    if at(c.st, 20) > 0
        c.st.insert(20, at(c.st, 20) - 1)
        v = v | 0x08
    v

@tier(app)
fn reg_read(c: Cam, r: Int) -> Int
    if r == 0x44
        return state_read(c)
    if r == 0x40
        return at(c.st, 18)
    if r == 0x41
        return at(c.st, 41) | 0xC0
    if r == 0x42
        return at(c.st, 42) | 0xF0
    if r == 0x43
        return at(c.st, 43) | 0xE0
    if r == 0x49
        return at(c.st, 44)
    if r == 0x45
        return at(c.st, 13) & 0xFF
    if r == 0x46
        return (at(c.st, 13) >> 8) & 0xFF
    if r == 0x47
        return (at(c.st, 13) >> 16) & 0xFF
    at(c.regs, r)

@tier(app)
fn reg_write(c: Cam, r: Int, v: Int)
    if r == 0x04
        if (v & 1) != 0
            c.st.insert(21, 0)
        if (v & 2) != 0
            c.st.insert(6, 1)
            c.st.insert(7, 0)
            c.st.insert(8, 0)
            c.st.insert(21, 0)
        return
    if r == 0x07 and (v & 0x40) != 0
        c.regs.clear()
        c.st.insert(21, 0)
        c.st.insert(6, 0)
        c.st.insert(4, at(c.st, 22))
        return
    c.regs.insert(r, v)

struct FakeSpi
    c: Cam

impl SpiBus for FakeSpi
    @tier(app)
    fn init(self, freq: Int, mode: Int) [hw]
        self.c.st.insert(10, freq)
        self.c.st.insert(11, mode)

    @tier(app)
    fn transfer(self, b: Int) -> Int [hw]
        let c = self.c
        if at(c.st, 9) == 1
            log_push(c, b)
        if at(c.st, 3) == 0
            return 0xFF
        let k = at(c.st, 0)
        c.st.insert(0, k + 1)
        if k == 0
            if b == 0x3C
                c.st.insert(2, 3)
                if at(c.st, 8) == 0
                    c.st.insert(40, 1)
                else
                    c.st.insert(40, 0)
                c.st.insert(8, 1)
            elif (b & 0x80) != 0
                c.st.insert(2, 2)
                c.st.insert(1, b & 0x7F)
            else
                c.st.insert(2, 1)
                c.st.insert(1, b)
            return 0xFF
        let mode = at(c.st, 2)
        if mode == 1
            if k == 2
                return reg_read(c, at(c.st, 1))
            return 0xFF
        if mode == 2
            if k == 1
                reg_write(c, at(c.st, 1), b)
            return 0xFF
        if k == 1 and at(c.st, 40) == 1
            return 0xFF
        let p = at(c.st, 7)
        c.st.insert(7, p + 1)
        at(c.fifo, p)

    @tier(app)
    fn write(self, data: [u8]) [hw]
        for b in data
            let _ = self.transfer(b as Int)

    @tier(app)
    fn read(self, n: Int) -> [u8] [hw]
        var out: [u8] = []
        for _i in 0..n
            list.push(out, self.transfer(0xFF) as u8)
        out

// The GPIO double: the chip select falling opens a window, rising closes
// it.
struct FakePins
    c: Cam
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    @tier(app)
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    @tier(app)
    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)
        if pin == CS and val == 0
            self.c.st.insert(0, 0)
            self.c.st.insert(9, 1)
            log_push(self.c, 3)
        if pin == CS and val == 1 and at(self.c.st, 9) == 1
            self.c.st.insert(9, 0)
            log_push(self.c, -1)

    @tier(app)
    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

@tier(app)
fn pins(c: Cam) -> FakePins
    FakePins { c: c, levels: HashMap.new(), modes: HashMap.new() }

@tier(app)
fn wiring() -> DeviceWiring
    dev_bus.wiring_spi(0, CS)

// The port over the double, with the refusals the state keys 30 to 34 ask
// for.
struct Dut
    bus: FakeSpi
    pins: FakePins
    w: DeviceWiring
    c: Cam

impl MegaPort for Dut
    @tier(app)
    fn setup(self) -> Bool [hw]
        if at(self.c.st, 33) == 1
            return false
        arducam_mega.spi_setup(self.bus, self.pins, self.w)

    @tier(app)
    fn read_reg(self, reg: Int) -> ?Int [hw]
        if at(self.c.st, 31) == reg + 1
            return None
        arducam_mega.spi_reg_read(self.bus, self.pins, self.w, reg)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        if at(self.c.st, 30) == reg + 1
            if at(self.c.st, 34) == 0 or at(self.c.st, 34) == v + 1
                return false
        arducam_mega.spi_reg_write(self.bus, self.pins, self.w, reg, v)

    @tier(app)
    fn burst(self, first: Bool, n: Int, var dst: MegaChunk) -> Bool [hw]
        if at(self.c.st, 32) == 1
            dst.clear()
            return false
        arducam_mega.spi_burst(self.bus, self.pins, self.w, first, n, var dst)

    @tier(app)
    fn wait_ms(self, ms: Int) [hw]
        self.c.st.insert(14, at(self.c.st, 14) + ms)

@tier(app)
fn dut(c: Cam) -> Dut
    Dut { bus: FakeSpi { c: c }, pins: pins(c), w: wiring(), c: c }

// The state with the sleep flag set.
@tier(app)
fn slept(st: MegaState) -> MegaState
    MegaState { model: st.model, format: st.format, res: st.res, first: st.first, total: st.total, left: st.left, asleep: true }

// ── The recorded picture ─────────────────────────────────────────────

// The bytes of `tests/data/capture_16x16.jpg`.
@tier(app)
fn picture() -> [Int] [fs]
    var out: [Int] = []
    let Some(b) = fs.read_bytes("tests/data/capture_16x16.jpg") else return out
    for i in 0..bytes.len(b)
        list.push(out, bytes.byte_at(b, i) ?? 0)
    out

// Loads `data` into the FIFO, followed by `pad` zero bytes, and sets the
// length the module reports to the whole.
@tier(app)
fn load(c: Cam, data: [Int], pad: Int)
    for i in 0..data.len()
        c.fifo.insert(i, data[i])
    for i in 0..pad
        c.fifo.insert(data.len() + i, 0)
    c.st.insert(12, data.len() + pad)
    c.st.insert(13, data.len() + pad)

// A module brought up and set to JPEG at 640x480, with the log cleared:
// the state `st` is what the driver holds.
@tier(app)
fn ready(d: Dut, var st: MegaState)
    d.c.st.insert(67, 1)
    test.assert(arducam_mega.bring_up(d, var st))
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    d.c.st.insert(67, 0)
    log_clear(d.c)

// ── The SPI framing ──────────────────────────────────────────────────

@test
fn test_a_register_read_is_the_command_a_dummy_byte_and_the_value() [io, hw]
    let c = cam()
    c.regs.insert(0x20, 0x01)
    let d = dut(c)
    test.assert_eq(arducam_mega.get(d, 0x20) ?? -1, 1)
    log_is(c, rd_log(0x20))
    // Bit 7 of the register is the write bit and is not part of a read.
    test.assert_eq(arducam_mega.get(d, 0xA0) ?? -1, 1)
    log_is(c, rd_log(0x20))

@test
fn test_a_register_write_sets_bit_7_of_the_command() [io, hw]
    let c = cam()
    let d = dut(c)
    test.assert(arducam_mega.put(d, 0x22, 0x05))
    log_is(c, wr_log(0x22, 0x05))
    test.assert_eq(at(c.regs, 0x22), 5)
    test.assert(arducam_mega.put(d, 0x23, 0x1FF))
    log_is(c, wr_log(0x23, 0xFF))

@test
fn test_the_first_burst_has_a_dummy_byte_and_the_later_ones_have_none() [io, hw]
    let c = cam()
    let img = picture()
    load(c, img, 0)
    let d = dut(c)
    var a: MegaChunk = Vec.new()
    test.assert(arducam_mega.spi_burst(d.bus, d.pins, d.w, true, 4, var a))
    log_is(c, burst_log(true, 4))
    test.assert_eq(a.len(), 4)
    for i in 0..4
        test.assert_eq(a[i] as Int, img[i])
    var b: MegaChunk = Vec.new()
    test.assert(arducam_mega.spi_burst(d.bus, d.pins, d.w, false, 3, var b))
    log_is(c, burst_log(false, 3))
    for i in 0..3
        test.assert_eq(b[i] as Int, img[4 + i])

@test
fn test_a_burst_that_does_not_fit_or_has_no_chip_select_is_not_run() [io, hw]
    let c = cam()
    let d = dut(c)
    var a: MegaChunk = Vec.new()
    test.assert(not arducam_mega.spi_burst(d.bus, d.pins, d.w, true, 257, var a))
    test.assert_eq(at(c.st, 99), 0)
    let nowire = dev_bus.wiring_i2c(0, 0x29)
    test.assert(not arducam_mega.spi_burst(d.bus, d.pins, nowire, true, 4, var a))
    test.assert(arducam_mega.spi_reg_read(d.bus, d.pins, nowire, 0x40) == None)
    test.assert(not arducam_mega.spi_reg_write(d.bus, d.pins, nowire, 0x20, 1))
    test.assert(not arducam_mega.spi_setup(d.bus, d.pins, nowire))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_the_bus_is_set_up_with_chip_select_high_at_8_mhz_in_mode_0() [io, hw]
    let c = cam()
    let d = dut(c)
    test.assert(arducam_mega.spi_setup(d.bus, d.pins, d.w))
    test.assert_eq(at(d.pins.levels, CS), 1)
    test.assert_eq(at(d.pins.modes, CS), 1)
    test.assert_eq(at(c.st, 10), 8000000)
    test.assert_eq(at(c.st, 11), 0)

@test
fn test_a_module_that_is_not_there_reads_0xff() [io, hw]
    let c = cam()
    c.st.insert(3, 0)
    let d = dut(c)
    test.assert_eq(arducam_mega.get(d, 0x40) ?? -1, 0xFF)

// ── Bring-up ─────────────────────────────────────────────────────────

@test
fn test_bring_up_resets_waits_for_idle_reads_the_id_and_sets_the_sensor_address() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    test.assert(arducam_mega.bring_up(d, var st))
    test.assert_eq(st.model, 0x85)
    var want: [Int] = []
    for part in [wr_log(0x07, 0x40), rd_log(0x44), rd_log(0x40), wr_log(0x0A, 0x78), rd_log(0x44)]
        for v in part
            list.push(want, v)
    log_is(c, want)
    test.assert_eq(at(c.st, 10), 8000000)
    test.assert_eq(at(c.regs, 0x0A), 0x78)

@test
fn test_bring_up_waits_for_a_reset_that_leaves_the_sensor_bus_busy() [io, hw]
    let c = cam()
    c.st.insert(22, 5)
    c.st.insert(67, 1)
    let d = dut(c)
    var st = arducam_mega.state_new()
    test.assert(arducam_mega.bring_up(d, var st))
    test.assert_eq(at(c.st, 14), 10)

@test
fn test_bring_up_accepts_the_seven_ids_and_refuses_the_rest() [io, hw]
    for id in [0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87]
        let c = cam()
        c.st.insert(18, id)
        c.st.insert(67, 1)
        var st = arducam_mega.state_new()
        test.assert(arducam_mega.bring_up(dut(c), var st))
        test.assert_eq(st.model, id)
        test.assert_eq(arducam_mega.sensor_id(dut(c)) ?? -1, id)
    for id in [0x00, 0x80, 0x88, 0xFF]
        let c = cam()
        c.st.insert(18, id)
        c.st.insert(67, 1)
        var st = arducam_mega.state_new()
        test.assert(not arducam_mega.bring_up(dut(c), var st))
        test.assert_eq(st.model, 0)

@test
fn test_bring_up_gives_up_on_a_module_that_is_not_there_after_the_bounded_wait() [io, hw]
    let c = cam()
    c.st.insert(3, 0)
    c.st.insert(67, 1)
    var st = arducam_mega.state_new()
    test.assert(not arducam_mega.bring_up(dut(c), var st))
    test.assert_eq(at(c.st, 14), 1200)

@test
fn test_bring_up_stops_at_each_refusal_of_the_port() [io, hw]
    var st = arducam_mega.state_new()
    let c1 = cam()
    c1.st.insert(33, 1)
    test.assert(not arducam_mega.bring_up(dut(c1), var st))
    let c2 = cam()
    c2.st.insert(30, 0x07 + 1)
    test.assert(not arducam_mega.bring_up(dut(c2), var st))
    let c3 = cam()
    c3.st.insert(31, 0x44 + 1)
    test.assert(not arducam_mega.bring_up(dut(c3), var st))
    let c4 = cam()
    c4.st.insert(31, 0x40 + 1)
    test.assert(not arducam_mega.bring_up(dut(c4), var st))
    let c5 = cam()
    c5.st.insert(30, 0x0A + 1)
    test.assert(not arducam_mega.bring_up(dut(c5), var st))
    test.assert_eq(st.model, 0)

@test
fn test_the_firmware_date_and_number_are_masked() [io, hw]
    let c = cam()
    let d = dut(c)
    let v = arducam_mega.firmware_version(d)
    test.assert(v == Some(MegaVersion { year: 25, month: 2, day: 28, number: 3 }))
    c.st.insert(31, 0x41 + 1)
    test.assert(arducam_mega.firmware_version(d) == None)
    c.st.insert(31, 0x42 + 1)
    test.assert(arducam_mega.firmware_version(d) == None)
    c.st.insert(31, 0x43 + 1)
    test.assert(arducam_mega.firmware_version(d) == None)
    c.st.insert(31, 0x49 + 1)
    test.assert(arducam_mega.firmware_version(d) == None)

@test
fn test_a_reset_forgets_the_format_and_the_size() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert_eq(st.format, 1)
    test.assert(arducam_mega.module_reset(d, var st))
    test.assert_eq(st.format, 0)
    test.assert_eq(st.res, -1)
    test.assert_eq(st.model, 0x85)
    log_is(c, [3, 0x87, 0x40, -1, 3, 0x44, 0, 0, -1])
    c.st.insert(30, 0x07 + 1)
    test.assert(not arducam_mega.module_reset(d, var st))

// ── Format and size ──────────────────────────────────────────────────

@test
fn test_the_format_is_written_and_then_the_size() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    d.c.st.insert(67, 1)
    test.assert(arducam_mega.bring_up(d, var st))
    d.c.st.insert(67, 0)
    log_clear(c)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    var want: [Int] = []
    for part in [wr_log(0x20, 1), rd_log(0x44), wr_log(0x21, 5), rd_log(0x44)]
        for v in part
            list.push(want, v)
    log_is(c, want)

@test
fn test_a_repeated_setting_sends_nothing_and_a_format_change_rewrites_the_size() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    test.assert_eq(at(c.st, 99), 0)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_320X240))
    var want: [Int] = []
    for part in [wr_log(0x21, 3), rd_log(0x44)]
        for v in part
            list.push(want, v)
    log_is(c, want)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_RGB565, arducam_mega.RES_320X240))
    var want2: [Int] = []
    for part in [wr_log(0x20, 2), rd_log(0x44), wr_log(0x21, 3), rd_log(0x44)]
        for v in part
            list.push(want2, v)
    log_is(c, want2)
    test.assert_eq(at(c.regs, 0x20), 2)

@test
fn test_the_legacy_modules_take_the_older_size_codes() [io, hw]
    let c = cam()
    c.st.insert(18, 0x82)
    c.st.insert(67, 1)
    let d = dut(c)
    var st = arducam_mega.state_new()
    test.assert(arducam_mega.bring_up(d, var st))
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_YUV, arducam_mega.RES_2048X1536))
    test.assert_eq(at(c.regs, 0x21), 8)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_YUV, arducam_mega.RES_96X96))
    test.assert_eq(at(c.regs, 0x21), 10)
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_YUV, arducam_mega.RES_320X320))
    test.assert_eq(at(c.regs, 0x21), 12)
    // The legacy modules have no 1024x768.
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_YUV, arducam_mega.RES_1024X768))
    test.assert_eq(at(c.regs, 0x21), 12)

@test
fn test_a_setting_the_module_does_not_have_is_refused_before_anything_is_sent() [io, hw]
    let c = cam()
    c.st.insert(18, 0x86)
    let d = dut(c)
    var st = arducam_mega.state_new()
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    ready(d, var st)
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_2592X1944))
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, -1))
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, 14))
    test.assert(not arducam_mega.format_set(d, var st, 0, arducam_mega.RES_640X480))
    test.assert(not arducam_mega.format_set(d, var st, 4, arducam_mega.RES_640X480))
    st = slept(st)
    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_YUV, arducam_mega.RES_640X480))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_refused_write_leaves_the_state_as_it_was() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
