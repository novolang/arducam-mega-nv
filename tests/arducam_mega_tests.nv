    test.assert(not arducam_mega.format_set(d, var st, arducam_mega.FMT_RGB565, arducam_mega.RES_640X480))
    test.assert_eq(st.format, 2)
    test.assert_eq(st.res, -1)

// ── The capture ──────────────────────────────────────────────────────

@test
fn test_a_capture_clears_the_flag_starts_polls_and_reads_the_length() [io, hw]
    let c = cam()
    let d = dut(c)
    let img = picture()
    load(c, img, 0)
    var st = arducam_mega.state_new()
    ready(d, var st)
    c.st.insert(5, 2)
    test.assert(arducam_mega.frame_capture(d, var st))
    var want: [Int] = []
    for part in [wr_log(0x04, 1), wr_log(0x04, 2), rd_log(0x44), rd_log(0x44), rd_log(0x44), rd_log(0x45), rd_log(0x46), rd_log(0x47)]
        for v in part
            list.push(want, v)
    log_is(c, want)
    test.assert_eq(st.total, img.len())
    test.assert_eq(st.left, img.len())
    test.assert(st.first)
    test.assert_eq(at(c.st, 14), 4)

@test
fn test_the_length_is_24_bits() [io, hw]
