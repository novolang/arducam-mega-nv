    test.assert(not arducam_mega.sharpness_set(d3, s3, 9))
    test.assert(not arducam_mega.sharpness_set(d3, s3, -1))
    test.assert(not arducam_mega.focus_set(d3, s3, 1))
    let c5 = cam()
    c5.st.insert(18, 0x81)
