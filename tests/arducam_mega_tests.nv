    var s5 = arducam_mega.state_new()
    ready(d5, var s5)
    test.assert(arducam_mega.focus_set(d5, s5, 4))
    test.assert_eq(at(c5.regs, 0x29), 4)
    test.assert(not arducam_mega.focus_set(d5, s5, 5))
    test.assert(not arducam_mega.focus_set(d5, s5, -1))
    test.assert(not arducam_mega.sharpness_set(d5, s5, 1))

@test
fn test_the_automatic_modes_set_bit_7_and_the_new_family_waits_for_bit_3() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    c.st.insert(20, 3)
    test.assert(arducam_mega.auto_set(d, st, arducam_mega.AUTO_WHITE_BALANCE, true))
    test.assert_eq(at(c.regs, 0x30), 0x82)
    test.assert_eq(at(c.st, 20), 0)
    test.assert(arducam_mega.auto_set(d, st, arducam_mega.AUTO_EXPOSURE, false))
    test.assert_eq(at(c.regs, 0x30), 0x01)
    test.assert(arducam_mega.auto_set(d, st, arducam_mega.AUTO_GAIN, true))
    test.assert_eq(at(c.regs, 0x30), 0x80)
    test.assert(not arducam_mega.auto_set(d, st, 3, true))
    test.assert(not arducam_mega.auto_set(d, st, -1, true))
    // Bit 3 that never clears is given up on.
    c.st.insert(20, 5000)
    test.assert(not arducam_mega.auto_set(d, st, arducam_mega.AUTO_GAIN, true))
    c.st.insert(20, 0)
    c.st.insert(30, 0x30 + 1)
    test.assert(not arducam_mega.auto_set(d, st, arducam_mega.AUTO_GAIN, true))
    c.st.insert(30, 0)
    c.st.insert(31, 0x44 + 1)
    test.assert(not arducam_mega.auto_set(d, st, arducam_mega.AUTO_GAIN, true))
    // A legacy module does not wait for bit 3.
    let cl = cam()
    cl.st.insert(18, 0x84)
    let dl = dut(cl)
    var sl = arducam_mega.state_new()
    ready(dl, var sl)
    cl.st.insert(20, 5000)
    test.assert(arducam_mega.auto_set(dl, sl, arducam_mega.AUTO_GAIN, true))

@test
fn test_the_busy_wait_reads_the_state_each_time() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    // The write is acknowledged, the sensor bus is idle, and bit 3 is read
    // until it clears: three reads of the state in all after the write.
    c.st.insert(20, 2)
    test.assert(arducam_mega.auto_set(d, st, arducam_mega.AUTO_EXPOSURE, true))
    test.assert_eq(at(c.st, 14), 2)

@test
fn test_manual_exposure_is_written_in_three_bytes_on_a_legacy_module_and_two_on_a_new_one() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.exposure_set(d, st, 0x1234))
    test.assert_eq(at(c.regs, 0x34), 0x12)
    test.assert_eq(at(c.regs, 0x35), 0x34)
    test.assert_eq(at(c.regs, 0x33), 0)
    test.assert(not arducam_mega.exposure_set(d, st, 0))
    test.assert(not arducam_mega.exposure_set(d, st, 10001))
    c.st.insert(30, 0x34 + 1)
    test.assert(not arducam_mega.exposure_set(d, st, 100))
    c.st.insert(30, 0x35 + 1)
    test.assert(not arducam_mega.exposure_set(d, st, 100))
    let cl = cam()
    cl.st.insert(18, 0x84)
    let dl = dut(cl)
    var sl = arducam_mega.state_new()
    ready(dl, var sl)
    test.assert(arducam_mega.exposure_set(dl, sl, 0x1234))
    test.assert_eq(at(cl.regs, 0x33), 0x00)
    test.assert_eq(at(cl.regs, 0x34), 0x12)
    test.assert_eq(at(cl.regs, 0x35), 0x34)
    test.assert(arducam_mega.exposure_set(dl, sl, 0xFFFF))
    test.assert(not arducam_mega.exposure_set(dl, sl, 0x10000))
    cl.st.insert(30, 0x33 + 1)
    test.assert(not arducam_mega.exposure_set(dl, sl, 100))

@test
fn test_manual_gain_is_two_registers_and_the_ov3640_table_is_indexed_not_trusted() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.gain_set(d, st, 240))
    test.assert_eq(at(c.regs, 0x31), 0)
    test.assert_eq(at(c.regs, 0x32), 240)
    test.assert(arducam_mega.gain_set(d, st, 0))
    test.assert(not arducam_mega.gain_set(d, st, 241))
    test.assert(not arducam_mega.gain_set(d, st, -1))
    c.st.insert(30, 0x31 + 1)
    test.assert(not arducam_mega.gain_set(d, st, 10))
    c.st.insert(30, 0x32 + 1)
    test.assert(not arducam_mega.gain_set(d, st, 10))
    let c2 = cam()
    c2.st.insert(18, 0x82)
    let d2 = dut(c2)
    var s2 = arducam_mega.state_new()
    ready(d2, var s2)
    test.assert(arducam_mega.gain_set(d2, s2, 1))
    test.assert_eq(at(c2.regs, 0x32), 0x00)
    test.assert(arducam_mega.gain_set(d2, s2, 9))
    test.assert_eq(at(c2.regs, 0x32), 0x72)
    test.assert(arducam_mega.gain_set(d2, s2, 31))
    test.assert_eq(at(c2.regs, 0x32), 0xFF)
    test.assert(not arducam_mega.gain_set(d2, s2, 32))
    test.assert(not arducam_mega.gain_set(d2, s2, 0))
    let c4 = cam()
    c4.st.insert(18, 0x84)
    let d4 = dut(c4)
    var s4 = arducam_mega.state_new()
    ready(d4, var s4)
    test.assert(arducam_mega.gain_set(d4, s4, 0x3FF))
    test.assert_eq(at(c4.regs, 0x31), 0x03)
    test.assert_eq(at(c4.regs, 0x32), 0xFF)

@test
fn test_ae_and_awb_freeze_exist_on_the_new_family_only() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.ae_freeze_set(d, st, true))
    test.assert_eq(at(c.regs, 0x2C), 1)
    test.assert(arducam_mega.ae_freeze_set(d, st, false))
    test.assert_eq(at(c.regs, 0x2C), 0)
    test.assert(arducam_mega.awb_freeze_set(d, st, true))
    test.assert_eq(at(c.regs, 0x2D), 1)
    test.assert(arducam_mega.awb_freeze_set(d, st, false))
    test.assert_eq(at(c.regs, 0x2D), 0)
    let cl = cam()
    cl.st.insert(18, 0x83)
    let dl = dut(cl)
    var sl = arducam_mega.state_new()
    ready(dl, var sl)
    test.assert(not arducam_mega.ae_freeze_set(dl, sl, true))
    test.assert(not arducam_mega.awb_freeze_set(dl, sl, true))

// ── Low power ────────────────────────────────────────────────────────

@test
fn test_low_power_on_the_legacy_modules_writes_register_2() [io, hw]
    for id in [0x81, 0x82]
        let c = cam()
        c.st.insert(18, id)
        let d = dut(c)
        var st = arducam_mega.state_new()
        ready(d, var st)
        test.assert(arducam_mega.power_set(d, var st, true))
        log_is(c, wr_log(0x02, 0x07))
        test.assert(st.asleep)
        test.assert(arducam_mega.power_set(d, var st, false))
        log_is(c, wr_log(0x02, 0x05))
        test.assert(not st.asleep)
        c.st.insert(30, 0x02 + 1)
        test.assert(not arducam_mega.power_set(d, var st, true))
        test.assert(not st.asleep)

@test
fn test_low_power_on_the_new_family_writes_register_0x28_and_waits() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.power_set(d, var st, true))
    var want: [Int] = []
    for part in [wr_log(0x28, 1), rd_log(0x44)]
        for v in part
            list.push(want, v)
    log_is(c, want)
    test.assert(st.asleep)
    test.assert(arducam_mega.power_set(d, var st, false))
    test.assert_eq(at(c.regs, 0x28), 0)
    test.assert(not st.asleep)

@test
fn test_low_power_on_the_two_underscore_2_modules_writes_three_sensor_registers() [io, hw]
    for id in [0x83, 0x84]
        let c = cam()
        c.st.insert(18, id)
        let d = dut(c)
        var st = arducam_mega.state_new()
        ready(d, var st)
        test.assert(arducam_mega.power_set(d, var st, true))
        var want: [Int] = []
        let idle = rd_log(0x44)
        for part in [wr_log(0x0B, 0x00), idle, wr_log(0x0C, 0x28), idle, wr_log(0x0E, 0xD0), idle, wr_log(0x0D, 0x00), idle,
                     wr_log(0x0B, 0x00), idle, wr_log(0x0C, 0x2A), idle, wr_log(0x0E, 0x10), idle, wr_log(0x0D, 0x7E), idle,
                     wr_log(0x0B, 0x0F), idle, wr_log(0x0C, 0x12), idle, wr_log(0x0E, 0x00), idle, wr_log(0x0D, 0x01), idle]
            for v in part
                list.push(want, v)
        log_is(c, want)
        test.assert(st.asleep)
        test.assert(arducam_mega.power_set(d, var st, false))
        test.assert_eq(at(c.regs, 0x0D), 0)
        test.assert(not st.asleep)

@test
fn test_low_power_stops_at_each_refused_sensor_write() [io, hw]
    let regs = [0x0B, 0x0C, 0x0E, 0x0D]
    for r in regs
        let c = cam()
        c.st.insert(18, 0x83)
        let d = dut(c)
        var st = arducam_mega.state_new()
        ready(d, var st)
        c.st.insert(30, r + 1)
        test.assert(not arducam_mega.power_set(d, var st, true))
        test.assert(not st.asleep)
    // The second and the third group fail on their own value.
    for pair in [[0x0C, 0x2A], [0x0D, 0x7E], [0x0C, 0x12], [0x0E, 0x00]]
        let c = cam()
        c.st.insert(18, 0x84)
        let d = dut(c)
        var st = arducam_mega.state_new()
        ready(d, var st)
        c.st.insert(30, pair[0] + 1)
        c.st.insert(34, pair[1] + 1)
        test.assert(not arducam_mega.power_set(d, var st, true))
    for pair in [[0x0B, 0x00], [0x0E, 0x10], [0x0C, 0x28], [0x0E, 0xD0]]
        let c = cam()
        c.st.insert(18, 0x84)
        let d = dut(c)
        var st = arducam_mega.state_new()
        ready(d, var st)
        c.st.insert(30, pair[0] + 1)
        c.st.insert(34, pair[1] + 1)
        test.assert(not arducam_mega.power_set(d, var st, true))

@test
fn test_low_power_is_refused_before_bring_up() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    test.assert(not arducam_mega.power_set(d, var st, true))
    test.assert_eq(at(c.st, 99), 0)

// ── The tables ───────────────────────────────────────────────────────

@test
fn test_the_module_tables_follow_the_sdk() [io, hw]
    test.assert(arducam_mega.model_known(0x81))
    test.assert(arducam_mega.model_known(0x87))
    test.assert(not arducam_mega.model_known(0x80))
    test.assert(not arducam_mega.model_known(0x88))
    test.assert(arducam_mega.model_new(0x85))
    test.assert(not arducam_mega.model_new(0x84))
    test.assert(not arducam_mega.model_new(0x88))
    test.assert_eq(arducam_mega.model_megapixels(0x81), 5)
    test.assert_eq(arducam_mega.model_megapixels(0x83), 5)
    test.assert_eq(arducam_mega.model_megapixels(0x85), 5)
    test.assert_eq(arducam_mega.model_megapixels(0x82), 3)
    test.assert_eq(arducam_mega.model_megapixels(0x84), 3)
    test.assert_eq(arducam_mega.model_megapixels(0x86), 3)
    test.assert_eq(arducam_mega.model_megapixels(0x87), 2)
    test.assert_eq(arducam_mega.model_megapixels(0x00), 0)
    test.assert_eq(arducam_mega.model_res_mask(0x00), 0)
    // The count of sizes each module takes.
    var counts: [Int] = []
    for id in [0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87]
        var n = 0
        for r in 0..14
            if arducam_mega.res_supported(id, r)
                n = n + 1
        list.push(counts, n)
    test.assert_eq(counts[0], 9)
    test.assert_eq(counts[1], 9)
    test.assert_eq(counts[2], 9)
    test.assert_eq(counts[3], 9)
    test.assert_eq(counts[4], 14)
    test.assert_eq(counts[5], 13)
    test.assert_eq(counts[6], 11)
    test.assert(arducam_mega.res_supported(0x81, arducam_mega.RES_2592X1944))
    test.assert(not arducam_mega.res_supported(0x81, arducam_mega.RES_2048X1536))
    test.assert(arducam_mega.res_supported(0x82, arducam_mega.RES_2048X1536))
    test.assert(not arducam_mega.res_supported(0x82, arducam_mega.RES_2592X1944))
    test.assert(not arducam_mega.res_supported(0x00, 0))
    test.assert(not arducam_mega.res_supported(0x85, 14))
    test.assert(not arducam_mega.res_supported(0x85, -1))
    // The legacy codes are the Application Note's table.
    var codes: [Int] = []
    for r in 0..14
        list.push(codes, arducam_mega.legacy_res_code(r))
    test.assert_eq(codes[0], 10)
    test.assert_eq(codes[1], 11)
    test.assert_eq(codes[2], -1)
    test.assert_eq(codes[3], 1)
    test.assert_eq(codes[4], 12)
    test.assert_eq(codes[5], 2)
    test.assert_eq(codes[6], -1)
    test.assert_eq(codes[7], -1)
    test.assert_eq(codes[8], 4)
    test.assert_eq(codes[9], -1)
    test.assert_eq(codes[10], 6)
    test.assert_eq(codes[11], 7)
    test.assert_eq(codes[12], 8)
    test.assert_eq(codes[13], 9)
    test.assert_eq(arducam_mega.res_code(0x85, 5), 5)
    test.assert_eq(arducam_mega.res_code(0x81, 5), 2)
    // The pixel sizes.
    var wh: [Int] = []
    for r in 0..14
        list.push(wh, arducam_mega.res_width(r) * 10000 + arducam_mega.res_height(r))
    test.assert_eq(wh[0], 96 * 10000 + 96)
    test.assert_eq(wh[2], 160 * 10000 + 120)
    test.assert_eq(wh[5], 640 * 10000 + 480)
    test.assert_eq(wh[9], 1280 * 10000 + 1024)
    test.assert_eq(wh[13], 2592 * 10000 + 1944)
    test.assert_eq(arducam_mega.res_width(14), 0)
    test.assert_eq(arducam_mega.res_height(14), 0)
    test.assert_eq(arducam_mega.res_width(1) * arducam_mega.res_height(1), 16384)
    test.assert_eq(arducam_mega.res_width(3) * arducam_mega.res_height(3), 76800)
    test.assert_eq(arducam_mega.res_width(4) * arducam_mega.res_height(4), 102400)
    test.assert_eq(arducam_mega.res_width(6) * arducam_mega.res_height(6), 480000)
    test.assert_eq(arducam_mega.res_width(7) * arducam_mega.res_height(7), 786432)
    test.assert_eq(arducam_mega.res_width(8) * arducam_mega.res_height(8), 921600)
    test.assert_eq(arducam_mega.res_width(10) * arducam_mega.res_height(10), 1920000)
    test.assert_eq(arducam_mega.res_width(11) * arducam_mega.res_height(11), 2073600)
    test.assert_eq(arducam_mega.res_width(12) * arducam_mega.res_height(12), 3145728)

@test
fn test_the_limits_follow_the_sdk() [io, hw]
    test.assert_eq(arducam_mega.exposure_min(0x85), 1)
    test.assert_eq(arducam_mega.exposure_max(0x85), 10000)
    test.assert_eq(arducam_mega.exposure_max(0x81), 30000)
    test.assert_eq(arducam_mega.exposure_max(0x83), 0xFFFF)
    test.assert_eq(arducam_mega.exposure_max(0x84), 0xFFFF)
    test.assert_eq(arducam_mega.gain_min(0x85), 0)
    test.assert_eq(arducam_mega.gain_min(0x81), 1)
    test.assert_eq(arducam_mega.gain_max(0x86), 240)
    test.assert_eq(arducam_mega.gain_max(0x81), 1023)
    test.assert_eq(arducam_mega.gain_max(0x82), 31)
    test.assert_eq(arducam_mega.gain_max(0x83), 0xFFFF)
    test.assert(arducam_mega.model_sharpness(0x84))
    test.assert(not arducam_mega.model_sharpness(0x85))
    test.assert(arducam_mega.model_focus(0x83))
    test.assert(not arducam_mega.model_focus(0x86))
    test.assert(arducam_mega.model_freeze(0x87))
    test.assert(not arducam_mega.model_freeze(0x81))

// ── The board's type, over absent hardware ───────────────────────────

@test
fn test_the_board_type_over_absent_hardware() [io, hw]
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    var cam = Arducam.attach(BoardSpi { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, w)
    test.assert(not cam.begin())
    test.assert_eq(cam.model(), 0)
    test.assert(cam.chip_id() == None)
    test.assert(cam.firmware() == None)
    test.assert(not cam.configure(arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    test.assert(not cam.capture())
    test.assert_eq(cam.frame_len(), 0)
    test.assert_eq(cam.frame_left(), 0)
    var chunk: MegaChunk = Vec.new()
    test.assert_eq(cam.read_chunk(16, var chunk), 0)
    // The link under the type: its burst and its wait.
    test.assert(not cam.link.burst(true, 4, var chunk))
    cam.link.wait_ms(1)
    test.assert(not cam.finish())
    test.assert(not cam.reset())
    test.assert(not cam.sleep())
    test.assert(not cam.wake())
    test.assert(not cam.set_brightness(1))
    test.assert(not cam.set_contrast(1))
    test.assert(not cam.set_saturation(1))
    test.assert(not cam.set_ev(1))
    test.assert(not cam.set_white_balance(1))
    test.assert(not cam.set_effect(1))
    test.assert(not cam.set_quality(1))
    test.assert(not cam.set_rotation(true))
    test.assert(not cam.set_sharpness(1))
    test.assert(not cam.set_focus(1))
    test.assert(not cam.set_auto(0, true))
    test.assert(not cam.set_exposure(100))
    test.assert(not cam.set_gain(1))
    test.assert(not cam.freeze_ae(true))
    test.assert(not cam.freeze_awb(true))

// A board type whose state says it is brought up, so the type's methods
// reach the link: its bus is absent, so every transfer is refused.
@test
fn test_the_board_type_with_a_state_that_is_up_reaches_the_bus() [io, hw]
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    let up = MegaState { model: 0x85, format: 1, res: 5, first: true, total: 10, left: 10, asleep: false }
    var cam = Arducam { link: MegaLink { bus: BoardSpi { id: 0 }, timer: BoardTimer { id: 0 }, pins: BoardGpio { id: 0 }, w: w }, st: up }
    test.assert_eq(cam.frame_len(), 10)
    test.assert_eq(cam.frame_left(), 10)
    test.assert(not cam.configure(arducam_mega.FMT_RGB565, 5))
    test.assert(not cam.capture())
    var chunk: MegaChunk = Vec.new()
    test.assert_eq(cam.read_chunk(16, var chunk), 0)
    test.assert(not cam.set_brightness(1))
    test.assert(not cam.set_contrast(1))
    test.assert(not cam.set_saturation(1))
    test.assert(not cam.set_ev(1))
    test.assert(not cam.set_white_balance(1))
    test.assert(not cam.set_effect(1))
    test.assert(not cam.set_quality(1))
    test.assert(not cam.set_rotation(true))
    test.assert(not cam.set_auto(0, true))
    test.assert(not cam.set_exposure(100))
    test.assert(not cam.set_gain(1))
    test.assert(not cam.freeze_ae(true))
    test.assert(not cam.freeze_awb(true))
    test.assert(not cam.sleep())
    test.assert(not cam.wake())
    test.assert(not cam.reset())
    test.assert(not cam.finish())

// ── The host helper ──────────────────────────────────────────────────

@test
fn test_the_host_helper_trims_and_writes_a_picture() [io, hw, fs]
    let img = picture()
    var padded: [Int] = [9, 8, 0xFF, 0xFF]
    for b in img
        list.push(padded, b)
    for b in [0, 0, 0xFF, 0xD9, 7]
        list.push(padded, b)
    let trimmed = mega_file.jpeg_trim(padded)
    test.assert_eq(trimmed.len(), img.len())
    for i in 0..img.len()
        test.assert_eq(trimmed[i], img[i])
    // No start marker: unchanged.
    let plain = mega_file.jpeg_trim([1, 2, 3])
    test.assert_eq(plain.len(), 3)
    // A start and no end: to the end of the data.
    let open_end = mega_file.jpeg_trim([5, 0xFF, 0xD8, 1, 2])
    test.assert_eq(open_end.len(), 4)
    test.assert_eq(open_end[0], 0xFF)
    // The file is replaced, not overwritten in place.
    let out_path = fs.temp_file()
    test.assert(fs.write(out_path, "a much longer file than the picture, which has to disappear"))
    test.assert(mega_file.jpeg_save(out_path, padded))
    test.assert_eq(fs.size(out_path) ?? -1, img.len())
    let back = fs.read_bytes(out_path)
    test.assert(back != None)
    test.assert(mega_file.jpeg_write(out_path, img))
    test.assert_eq(fs.size(out_path) ?? -1, img.len())
    test.assert(fs.delete(out_path))
    test.assert(mega_file.jpeg_write(out_path, img))
    test.assert(fs.delete(out_path))

@test
fn test_the_host_helper_reports_a_file_it_cannot_write() [io, hw, fs]
    let dir = fs.temp_dir()
    test.assert(not mega_file.jpeg_write("${dir}/no/such/directory/x.jpg", [1, 2, 3]))
    // A path that exists and cannot be deleted: a directory with a file in it.
    let busy = "${dir}/busy"
    test.assert(fs.mkdir(busy))
    test.assert(fs.write("${busy}/f", "x"))
    test.assert(not mega_file.jpeg_write(busy, [1, 2, 3]))
    // A descriptor that is not one.
    test.assert(not mega_file.jpeg_put(-1, [1, 2, 3]))
    test.assert(fs.delete("${busy}/f"))
    test.assert(fs.delete(busy))
    test.assert(fs.delete(dir))

@test
fn test_the_idle_wait_polls_every_2_ms_up_to_the_tries_it_is_given() [io, hw]
    let c = cam()
    let d = dut(c)
    c.st.insert(4, 3)
    test.assert(arducam_mega.idle_wait(d, 5))
    test.assert_eq(at(c.st, 14), 6)
    c.st.insert(4, 9)
    c.st.insert(14, 0)
    test.assert(not arducam_mega.idle_wait(d, 4))
    test.assert_eq(at(c.st, 14), 8)
    c.st.insert(31, 0x44 + 1)
    test.assert(not arducam_mega.idle_wait(d, 4))
