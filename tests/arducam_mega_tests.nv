@test
fn test_a_capture_is_refused_before_setup_and_while_asleep() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 0)
    var st = arducam_mega.state_new()
    test.assert(not arducam_mega.frame_capture(d, var st))
    d.c.st.insert(67, 1)
    test.assert(arducam_mega.bring_up(d, var st))
    test.assert(not arducam_mega.frame_capture(d, var st))
    test.assert(arducam_mega.format_set(d, var st, arducam_mega.FMT_JPEG, arducam_mega.RES_640X480))
    st = slept(st)
    test.assert(not arducam_mega.frame_capture(d, var st))
    d.c.st.insert(67, 0)
    log_clear(c)
    test.assert(not arducam_mega.frame_capture(d, var st))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_capture_stops_at_each_refusal_of_the_port() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 0)
    var st = arducam_mega.state_new()
    ready(d, var st)
    c.st.insert(30, 0x04 + 1)
    c.st.insert(34, 1 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    c.st.insert(34, 2 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    c.st.insert(30, 0)
    c.st.insert(31, 0x44 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    c.st.insert(31, 0x45 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    c.st.insert(31, 0x46 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    c.st.insert(31, 0x47 + 1)
    test.assert(not arducam_mega.frame_capture(d, var st))
    test.assert_eq(st.total, 0)

// Reads the whole capture in chunks of `k` and answers the bytes.
@tier(app)
fn read_all(d: Dut, var st: MegaState, k: Int) -> [Int] [hw]
    var out: [Int] = []
    var chunk: MegaChunk = Vec.new()
    for _i in 0..5000
        let n = arducam_mega.chunk_read(d, var st, k, var chunk)
        if n == 0
            break
        test.assert_eq(chunk.len(), n)
        for j in 0..n
            list.push(out, chunk[j] as Int)
    out

@test
fn test_the_recorded_picture_is_read_back_in_chunks_of_any_size() [io, hw]
    let img = picture()
    test.assert_eq(img.len(), 304)
    for k in [1, 7, 63, 64, 100, 256, 1000]
        let c = cam()
        let d = dut(c)
        load(c, img, 0)
        var st = arducam_mega.state_new()
        ready(d, var st)
        test.assert(arducam_mega.frame_capture(d, var st))
        let got = read_all(d, var st, k)
        test.assert_eq(got.len(), img.len())
        for i in 0..img.len()
            test.assert_eq(got[i], img[i])
        test.assert_eq(st.left, 0)
        test.assert(not st.first)

@test
fn test_only_the_first_burst_of_a_capture_clocks_a_dummy_byte() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 0)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.frame_capture(d, var st))
    log_clear(c)
    var chunk: MegaChunk = Vec.new()
    test.assert_eq(arducam_mega.chunk_read(d, var st, 100, var chunk), 100)
    log_is(c, burst_log(true, 100))
    test.assert_eq(arducam_mega.chunk_read(d, var st, 100, var chunk), 100)
    log_is(c, burst_log(false, 100))
    test.assert_eq(arducam_mega.chunk_read(d, var st, 300, var chunk), 104)
    log_is(c, burst_log(false, 104))
    test.assert_eq(arducam_mega.chunk_read(d, var st, 10, var chunk), 0)
    test.assert_eq(chunk.len(), 0)
    test.assert_eq(at(c.st, 99), 0)
    // A second capture starts with a dummy byte again.
    test.assert(arducam_mega.frame_capture(d, var st))
    log_clear(c)
    test.assert_eq(arducam_mega.chunk_read(d, var st, 8, var chunk), 8)
    log_is(c, burst_log(true, 8))

@test
fn test_a_chunk_is_cut_to_the_buffer_and_a_bad_count_reads_nothing() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 40)
    var st = arducam_mega.state_new()
    ready(d, var st)
    var chunk: MegaChunk = Vec.new()
    test.assert_eq(arducam_mega.chunk_read(d, var st, 10, var chunk), 0)
    test.assert(arducam_mega.frame_capture(d, var st))
    test.assert_eq(arducam_mega.chunk_read(d, var st, 0, var chunk), 0)
    test.assert_eq(arducam_mega.chunk_read(d, var st, -5, var chunk), 0)
    test.assert_eq(st.left, 344)
    test.assert_eq(arducam_mega.chunk_read(d, var st, 1000, var chunk), 256)
    test.assert_eq(st.left, 88)

@test
fn test_a_burst_that_fails_keeps_the_first_flag_and_the_count() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 0)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.frame_capture(d, var st))
    c.st.insert(32, 1)
    var chunk: MegaChunk = Vec.new()
    test.assert_eq(arducam_mega.chunk_read(d, var st, 50, var chunk), 0)
    test.assert(st.first)
    test.assert_eq(st.left, 304)
    c.st.insert(32, 0)
    test.assert_eq(arducam_mega.chunk_read(d, var st, 50, var chunk), 50)
    test.assert_eq(chunk[0] as Int, 0xFF)
    test.assert_eq(chunk[1] as Int, 0xD8)

@test
fn test_ending_a_capture_clears_the_flag() [io, hw]
    let c = cam()
    let d = dut(c)
    load(c, picture(), 0)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.frame_capture(d, var st))
    test.assert_eq(at(c.st, 21), 1)
    log_clear(c)
    test.assert(arducam_mega.frame_end(d, var st))
    log_is(c, wr_log(0x04, 1))
    test.assert_eq(at(c.st, 21), 0)
    test.assert_eq(st.left, 0)
    test.assert_eq(st.total, 0)
    c.st.insert(30, 0x04 + 1)
    test.assert(not arducam_mega.frame_end(d, var st))

// ── The JPEG markers ─────────────────────────────────────────────────

// Reads the capture in chunks of `k`, scanning each, and answers the bytes
// the scan says belong to the picture.
@tier(app)
fn scan_all(d: Dut, var st: MegaState, k: Int, var s: JpegScan) -> [Int] [hw]
    var out: [Int] = []
    var chunk: MegaChunk = Vec.new()
    for _i in 0..5000
        let n = arducam_mega.chunk_read(d, var st, k, var chunk)
        if n == 0
            break
        mega_jpeg.scan_feed(var s, chunk, n)
        for _j in 0..s.lead
            list.push(out, 0xFF)
        for j in s.lo..s.hi
            list.push(out, chunk[j] as Int)
    out

@test
fn test_the_scan_finds_the_markers_for_any_chunk_size_and_a_tail_of_zeros() [io, hw]
    let img = picture()
    for pad in [0, 1, 40]
        for k in [1, 2, 3, 7, 63, 64, 255, 256]
            let c = cam()
            let d = dut(c)
            load(c, img, pad)
            var st = arducam_mega.state_new()
            ready(d, var st)
            test.assert(arducam_mega.frame_capture(d, var st))
            var s = mega_jpeg.scan_new()
            let got = scan_all(d, var st, k, var s)
            test.assert(mega_jpeg.scan_started(s))
            test.assert(mega_jpeg.scan_done(s))
            test.assert_eq(s.start, 0)
            test.assert_eq(s.end, img.len())
            test.assert_eq(mega_jpeg.scan_length(s), img.len())
            test.assert_eq(got.len(), img.len())
            for i in 0..img.len()
                test.assert_eq(got[i], img[i])

@test
fn test_a_picture_that_starts_after_some_bytes_is_cut_at_its_markers() [io, hw]
    let img = picture()
    var data: [Int] = [0, 0xFF, 0xFF, 0x12]
    for b in img
        list.push(data, b)
    for b in [0xFF, 0xD8, 0, 0xFF, 0xD9]
        list.push(data, b)
    for k in [1, 5, 256]
        let c = cam()
        let d = dut(c)
        load(c, data, 3)
        var st = arducam_mega.state_new()
        ready(d, var st)
        test.assert(arducam_mega.frame_capture(d, var st))
        var s = mega_jpeg.scan_new()
        let got = scan_all(d, var st, k, var s)
        test.assert_eq(s.start, 4)
        test.assert_eq(s.end, 4 + img.len())
        test.assert_eq(got.len(), img.len())
        for i in 0..img.len()
            test.assert_eq(got[i], img[i])

@test
fn test_a_stream_without_markers_has_no_picture() [io, hw]
    var s = mega_jpeg.scan_new()
    var chunk: MegaChunk = Vec.new()
    for b in [1, 2, 0xFF, 0xD0, 0xD8, 0xD9]
        let _ = chunk.push(b as u8)
    mega_jpeg.scan_feed(var s, chunk, 6)
    test.assert(not mega_jpeg.scan_started(s))
    test.assert(not mega_jpeg.scan_done(s))
    test.assert_eq(mega_jpeg.scan_length(s), -1)
    test.assert_eq(s.lo, 0)
    test.assert_eq(s.hi, 0)
    test.assert_eq(s.at, 6)
    // An end marker with no start before it is not an end.
    var t = mega_jpeg.scan_new()
    var c2: MegaChunk = Vec.new()
    for b in [0xFF, 0xD9, 5]
        let _ = c2.push(b as u8)
    mega_jpeg.scan_feed(var t, c2, 3)
    test.assert(not mega_jpeg.scan_done(t))
    // A start with no end is a length of -1, and a count past the chunk is cut.
    var u = mega_jpeg.scan_new()
    var c3: MegaChunk = Vec.new()
    for b in [7, 0xFF, 0xD8, 9]
        let _ = c3.push(b as u8)
    mega_jpeg.scan_feed(var u, c3, 99)
    test.assert(mega_jpeg.scan_started(u))
    test.assert_eq(mega_jpeg.scan_length(u), -1)
    test.assert_eq(u.start, 1)
    test.assert_eq(u.lo, 1)
    test.assert_eq(u.hi, 4)
    test.assert_eq(u.at, 4)
    // Later chunks after the end are outside the picture.
    var c4: MegaChunk = Vec.new()
    for b in [0xFF, 0xD9, 1, 2]
        let _ = c4.push(b as u8)
    mega_jpeg.scan_feed(var u, c4, 4)
    test.assert_eq(u.lo, 0)
    test.assert_eq(u.hi, 2)
    var c5: MegaChunk = Vec.new()
    let _ = c5.push(3 as u8)
    mega_jpeg.scan_feed(var u, c5, 1)
    test.assert_eq(u.lo, 0)
    test.assert_eq(u.hi, 0)
    test.assert_eq(u.lead, 0)

// ── The controls ─────────────────────────────────────────────────────

@test
fn test_the_step_codes_alternate_plus_and_minus() [io, hw]
    test.assert_eq(arducam_mega.level_code(0, 3), 0)
    test.assert_eq(arducam_mega.level_code(1, 3), 1)
    test.assert_eq(arducam_mega.level_code(-1, 3), 2)
    test.assert_eq(arducam_mega.level_code(2, 3), 3)
    test.assert_eq(arducam_mega.level_code(-2, 3), 4)
    test.assert_eq(arducam_mega.level_code(3, 3), 5)
    test.assert_eq(arducam_mega.level_code(-3, 3), 6)
    test.assert_eq(arducam_mega.level_code(4, 4), 7)
    test.assert_eq(arducam_mega.level_code(-4, 4), 8)
    test.assert_eq(arducam_mega.level_code(9, 3), 5)
    test.assert_eq(arducam_mega.level_code(-9, 3), 6)

@test
fn test_the_levels_are_written_to_their_registers() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.brightness_set(d, st, -4))
    test.assert_eq(at(c.regs, 0x22), 8)
    test.assert(arducam_mega.contrast_set(d, st, 2))
    test.assert_eq(at(c.regs, 0x23), 3)
    test.assert(arducam_mega.saturation_set(d, st, -3))
    test.assert_eq(at(c.regs, 0x24), 6)
    test.assert(arducam_mega.ev_set(d, st, 1))
    test.assert_eq(at(c.regs, 0x25), 1)
    test.assert(arducam_mega.white_balance_set(d, st, arducam_mega.WB_INDOOR))
    test.assert_eq(at(c.regs, 0x26), 4)
    test.assert(not arducam_mega.white_balance_set(d, st, 5))
    test.assert(not arducam_mega.white_balance_set(d, st, -1))
    test.assert(arducam_mega.quality_set(d, st, arducam_mega.QUALITY_LOW))
    test.assert_eq(at(c.regs, 0x2A), 2)
    test.assert(not arducam_mega.quality_set(d, st, 3))
    test.assert(not arducam_mega.quality_set(d, st, -1))
    test.assert(arducam_mega.rotation_set(d, st, true))
    test.assert_eq(at(c.regs, 0x2B), 1)
    test.assert(arducam_mega.rotation_set(d, st, false))
    test.assert_eq(at(c.regs, 0x2B), 0)

@test
fn test_every_control_is_refused_before_bring_up_and_while_asleep() [io, hw]
    let c = cam()
    let d = dut(c)
    var st = arducam_mega.state_new()
    for round in 0..2
        if round == 1
            ready(d, var st)
            st = slept(st)
        test.assert(not arducam_mega.brightness_set(d, st, 1))
        test.assert(not arducam_mega.contrast_set(d, st, 1))
        test.assert(not arducam_mega.saturation_set(d, st, 1))
        test.assert(not arducam_mega.ev_set(d, st, 1))
        test.assert(not arducam_mega.white_balance_set(d, st, 1))
        test.assert(not arducam_mega.effect_set(d, st, 1))
        test.assert(not arducam_mega.quality_set(d, st, 1))
        test.assert(not arducam_mega.rotation_set(d, st, true))
        test.assert(not arducam_mega.sharpness_set(d, st, 1))
        test.assert(not arducam_mega.focus_set(d, st, 1))
        test.assert(not arducam_mega.auto_set(d, st, 0, true))
        test.assert(not arducam_mega.exposure_set(d, st, 100))
        test.assert(not arducam_mega.gain_set(d, st, 10))
        test.assert(not arducam_mega.ae_freeze_set(d, st, true))
        test.assert(not arducam_mega.awb_freeze_set(d, st, true))
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_the_special_effects_follow_the_module() [io, hw]
    let c = cam()
    c.st.insert(18, 0x86)
    let d = dut(c)
    var st = arducam_mega.state_new()
    ready(d, var st)
    test.assert(arducam_mega.effect_set(d, st, arducam_mega.FX_SEPIA))
    test.assert_eq(at(c.regs, 0x27), 4)
    test.assert(arducam_mega.effect_set(d, st, arducam_mega.FX_LIGHT_YELLOW))
    test.assert_eq(at(c.regs, 0x27), 9)
    test.assert(not arducam_mega.effect_set(d, st, arducam_mega.FX_SOLARIZE))
    test.assert(not arducam_mega.effect_set(d, st, arducam_mega.FX_OVER_EXPOSURE))
    test.assert(not arducam_mega.effect_set(d, st, -1))
    let c5 = cam()
    let d5 = dut(c5)
    var st5 = arducam_mega.state_new()
    ready(d5, var st5)
    test.assert(arducam_mega.effect_set(d5, st5, arducam_mega.FX_GREENISH))
    test.assert(not arducam_mega.effect_set(d5, st5, arducam_mega.FX_LIGHT_YELLOW))
    test.assert(arducam_mega.effect_supported(0x82, 9))
    test.assert(not arducam_mega.effect_supported(0x85, 9))
    test.assert(not arducam_mega.effect_supported(0x87, 9))
    test.assert(arducam_mega.effect_supported(0x87, 0))

@test
fn test_sharpness_and_focus_only_where_the_module_has_them() [io, hw]
    let c3 = cam()
    c3.st.insert(18, 0x82)
    let d3 = dut(c3)
    var s3 = arducam_mega.state_new()
    ready(d3, var s3)
